  <project_license>GPL-3.0+</project_license>
  <name>DirCat</name>
  <summary>Directory catalog application</summary>
  
  <description>
    <p>
      DirCat is a JavaFX-based disk catalog application for Linux that helps you
      organize and browse your file collections.
    </p>
    <p>Features:</p>
    <ul>
      <li>Modern JavaFX GUI interface</li>
      <li>Recursive directory scanning and cataloging</li>
      <li>Compact storage using compressed XML database (gzipped)</li>
      <li>Fast search through cataloged content</li>
      <li>Save and load catalog files</li>
      <li>View file metadata (size, modification date, type)</li>
    </ul>
  </description>
  
  <launchable type="desktop-id">com.github.bantuQ.DirCat.desktop</launchable>
  
